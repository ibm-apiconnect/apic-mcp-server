{
  "mcpServers": {
    "apic-idig-standalone-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "<path-to-npm-package-tar>",
        "apic-idig-standalone-mcp-server"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "<0-to-disable-certificate-validation-or-1-to-enable>",
        "APIC_PLATFORM_URL": "<your-standalone-platform-url>",
        "APIC_MANAGEMENT_URL": "<your-standalone-management-url>",
        "STANDALONE_USERNAME": "<your-standalone-username>",
        "STANDALONE_PASSWORD": "<your-standalone-password>"
      }
    }
  }
}