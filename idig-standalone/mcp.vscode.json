{
    "inputs": [
        {
            "type": "promptString",
            "id": "username",
            "description": "Standalone Username",
            "password": false
        },
        {
            "type": "promptString",
            "id": "password",
            "description": "Standalone password",
            "password": true
        },
        {
            "type": "promptString",
            "id": "tarPath",
            "description": "Path to NPM package tar file",
            "password": false
        },
        {
            "type": "promptString",
            "id": "platformUrl",
            "description": "Standalone Platform URL",
            "password": false
        },
        {
            "type": "promptString",
            "id": "managementUrl",
            "description": "Standalone Management URL",
            "password": false
        },
        {
            "type": "promptString",
            "id": "validateCertificates",
            "description": "Whether to validate certificates for Standalone instance, set to '0' to disable validation or '1' to enable validation. Should be set to '0' if using self-signed certificates.",
            "required": false,
            "password": false,
            "default": "1"
        }
    ],
    "servers": {
        "apic-idig-standalone-mcp-server": {
            "command": "npx",
            "args": [
                "-y",
                "-p",
                "${input:tarPath}",
                "apic-idig-standalone-mcp-server"
            ],
            "env": {
                "STANDALONE_USERNAME": "${input:username}",
                "STANDALONE_PASSWORD": "${input:password}",
                "APIC_PLATFORM_URL": "${input:platformUrl}",
                "APIC_MANAGEMENT_URL": "${input:managementUrl}",
                "NODE_TLS_REJECT_UNAUTHORIZED": "${input:validateCertificates}"
            }
        }
    }
}